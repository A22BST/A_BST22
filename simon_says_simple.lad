// ============================================================================
// SIMON SAYS GAME - PHASE 1 (3 BUTTONS)
// Omron NX102-1100 PLC
// ============================================================================

// I/O MAPPING:
// DI1 = Yellow Button, DI3 = Blue Button, DI5 = Red Button
// DO0 = Red LED, DO1 = Blue LED, DO2 = Yellow LED

// MEMORY MAP:
// W0 = Game State (0=Idle, 1=Play, 2=Wait, 3=Over)
// W1 = Sequence Length
// W2 = Current Step
// W3 = Player Step
// W4-W53 = Sequence (50 steps max)
// W100 = Score
// W101 = Flash Time (500ms)
// W102 = Gap Time (200ms)

// ============================================================================
// INITIALIZATION
// ============================================================================
LD NOT W0.0
AND NOT W0.1
AND NOT W0.2
AND NOT W0.3
OUT W0.0           // Set to Idle
OUT W1.0           // Reset sequence length
OUT W2.0           // Reset current step
OUT W3.0           // Reset player step
OUT W100.0         // Reset score
LD #500
OUT W101           // Flash time = 500ms
LD #200
OUT W102           // Gap time = 200ms

// ============================================================================
// GAME START
// ============================================================================
LD W0.0            // Idle state
AND (DI1 OR DI3 OR DI5)  // Any button pressed
OUT W0.1           // Move to Play state
OUT W1.1           // Sequence length = 1
OUT W2.0           // Reset current step
OUT W3.0           // Reset player step

// Generate first random sequence
LD W0.1
AND NOT W2.0
CALL RND(1,3)
OUT W4             // Store in sequence

// ============================================================================
// SEQUENCE PLAYBACK
// ============================================================================
LD W0.1            // Play state
AND W2.0           // Current step > 0
AND W4[W2]         // Get sequence value
CMP #1             // Red button
AND CMP_EQ
TIM T100 W101      // Flash timer
AND T100
OUT DO0            // Red LED

LD W0.1            // Play state
AND W2.0           // Current step > 0
AND W4[W2]         // Get sequence value
CMP #2             // Blue button
AND CMP_EQ
TIM T101 W101      // Flash timer
AND T101
OUT DO1            // Blue LED

LD W0.1            // Play state
AND W2.0           // Current step > 0
AND W4[W2]         // Get sequence value
CMP #3             // Yellow button
AND CMP_EQ
TIM T102 W101      // Flash timer
AND T102
OUT DO2            // Yellow LED

// Advance to next step after flash + gap
LD W0.1
TIM T110 W102      // Gap timer
AND T110
OUT W2.1           // Increment current step

// Check if sequence complete
LD W0.1
AND W2.0
CMP W1.0           // Compare with sequence length
AND NOT CMP_EQ
OUT W0.2           // Move to Wait state
OUT W2.0           // Reset current step
OUT W3.0           // Reset player step

// ============================================================================
// PLAYER INPUT
// ============================================================================
LD W0.2            // Wait state
AND W3.0           // Player step > 0
AND W4[W3]         // Get expected value
CMP #1             // Red expected
AND CMP_EQ
AND DI5            // Red pressed
OUT W3.1           // Increment player step

LD W0.2            // Wait state
AND W3.0           // Player step > 0
AND W4[W3]         // Get expected value
CMP #2             // Blue expected
AND CMP_EQ
AND DI3            // Blue pressed
OUT W3.1           // Increment player step

LD W0.2            // Wait state
AND W3.0           // Player step > 0
AND W4[W3]         // Get expected value
CMP #3             // Yellow expected
AND CMP_EQ
AND DI1            // Yellow pressed
OUT W3.1           // Increment player step

// Wrong button - Game Over
LD W0.2
AND (DI1 OR DI3 OR DI5)  // Any button
AND W4[W3]         // Expected value
CMP #1             // Not Red
AND NOT CMP_EQ
LD W0.2
AND (DI1 OR DI3 OR DI5)  // Any button
AND W4[W3]         // Expected value
CMP #2             // Not Blue
AND NOT CMP_EQ
LD W0.2
AND (DI1 OR DI3 OR DI5)  // Any button
AND W4[W3]         // Expected value
CMP #3             // Not Yellow
AND NOT CMP_EQ
OUT W0.3           // Game Over

// Input timeout
LD W0.2
TIM T120 3000      // 3 second timeout
AND T120
OUT W0.3           // Game Over

// Sequence complete - Next level
LD W0.2
AND W3.0           // Player step
CMP W1.0           // Compare with sequence length
AND CMP_EQ
AND W3.0           // Player step > 0
OUT W100.1         // Increment score
OUT W1.1           // Increment sequence length
OUT W0.1           // Move to Play state
OUT W2.0           // Reset current step
OUT W3.0           // Reset player step

// Generate next random step
LD W0.1
AND W1.0           // New sequence length
ADD W4             // Add to sequence base
OUT W120           // Calculate position
CALL RND(1,3)
OUT [W120]         // Store new step

// ============================================================================
// GAME OVER
// ============================================================================
LD W0.3            // Game Over state
AND (DI1 OR DI3 OR DI5)  // Any button pressed
OUT W0.0           // Return to Idle

// ============================================================================
// END OF PROGRAM
// ============================================================================